# Databases. Two collector processes (rig.py and shadow/rig) are writing these
# RIGHT NOW; they are the evidence base, not source, and they must never be
# staged, stashed, or reverted by anything.
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Captured tapes. The live one is 4.3GB and still growing.
*.jsonl.gz
raw-*.jsonl

# Compiled binaries (the shadow collector binary is 4GB of build output).
shadow/rig
go/shadow/rig
go/cmd/rig/rig
go/cmd/harness/harness
go/cmd/replay/replay

__pycache__/
*.pyc
.DS_Store

# Loop transport artifacts. The raw model logs are large and low-signal; the
# durable state the loop actually reasons over (QUEUE, LEDGER, STATE, briefs and
# adjudications) IS tracked, because the audit trail is the point.
loop/raw-*.log
loop/run/*/raw-*.log

# Beads / Dolt files (added by bd init)
.dolt/
.beads-credential-key
.beads/proxieddb/

# Loop runtime state. Tracked STATE.json was reverted by the conductor's own
# scope-violation handler, wiping its counters mid-run.
loop/state/STATE.json
loop/state/STATE.json.tmp
loop/state/HEARTBEAT
loop/state/LOCK
loop/state/STOP
loop/state/conductor.log
loop/state/stdout.log
loop/run/

# Live collector artifacts. shadow/ is 4.3GB of tape + db + logs; rig.log grows
# continuously, and a SQLite journal appears and vanishes under the running
# collectors. Untracked-but-unignored files show up in `git status --porcelain`,
# which is what the conductor's scope check reads.
shadow/
*.db-journal
*.db-wal
