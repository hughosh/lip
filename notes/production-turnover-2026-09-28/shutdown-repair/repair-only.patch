+	if got := stepper.calls.Load(); got < 2 {
+		t.Fatalf("alert steps = %d, want immediate and final", got)
+	}
+	if h.rig.store.Health().AllowsAdding() {
+		t.Fatal("authorized close left store writer able to accept risk")
