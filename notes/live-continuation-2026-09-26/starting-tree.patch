-printf '%s\n' "${results[@]}"
-echo "DISK_FREE_GB: ${DISK_START} at start, $(free_gb) at end (a round needs ~15)"
-echo "LOAD: $(uptime | sed 's/.*load averages*: //')"
-echo "STEP_LOGS: $GATES_OUT"
