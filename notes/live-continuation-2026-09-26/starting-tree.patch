-    echo "VERDICT: GREEN"
-    [ $QUICK -eq 1 ] && echo "ADVANCE_ELIGIBLE: NO (quick run)" || echo "ADVANCE_ELIGIBLE: YES"
-    exit 0
-fi
-echo "VERDICT: RED"
-echo "ADVANCE_ELIGIBLE: NO"
-exit 1
